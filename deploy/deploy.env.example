# Settings for deploy/deploy.sh on this host. Copy this file to deploy/deploy.env, which
# is not tracked by git, and change the values that differ from their defaults.
# Command-line options override these values.

# The path of the infield-fly command. Defaults to .venv/bin/infield-fly in the clone if
# there is a virtual environment, otherwise to the infield-fly command on the PATH, or
# ~/.local/bin/infield-fly.
#INFIELD_FLY_COMMAND=/home/user/.local/bin/infield-fly

# The command used to install Infield Fly. Defaults to .venv/bin/pip in the clone if
# there is a virtual environment, otherwise to "python3 -m pip" installing for the user.
#PIP_COMMAND="python3 -m pip install --user"

# The path of the settings file. Defaults to $INFIELD_FLY_CONFIG, or
# ~/.config/infield-fly/settings.json.
#SETTINGS_FILE=/home/user/.config/infield-fly/settings.json

# The local port of the web interface.
#WEB_PORT=8642

# The Apache configuration file to install, which must be included by the site's HTTPS
# virtual host. Defaults to /etc/apache2/userconf-enabled/infield-fly.conf if that
# directory exists; otherwise the Apache configuration is not installed.
#APACHE_CONF=/etc/apache2/userconf-enabled/infield-fly.conf
