# systemd unit running the Infield Fly web interface as the account that runs the
# scheduled job processing, so both work with the same files.
#
# deploy/deploy.sh fills in the values in capitals and installs this as
# /etc/systemd/system/infield-fly-web.service. To install it by hand, replace them:
#   YOUR_USER             the account running Infield Fly
#   INFIELD_FLY_CHECKOUT  the directory of the Infield Fly clone
#   INFIELD_FLY_COMMAND   the path of the infield-fly command
#   SETTINGS_FILE         the path of the settings file
#   WEB_PORT              the local port of the web interface, such as 8642
# then run:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now infield-fly-web
[Unit]
Description=Infield Fly web interface
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=INFIELD_FLY_CHECKOUT
ExecStart=INFIELD_FLY_COMMAND -c SETTINGS_FILE web --port WEB_PORT --root-path /infield-fly
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=full
# Stop only the web interface itself, so that job processing runs started from it keep
# running, rather than being interrupted mid-conversion, when it is restarted.
KillMode=process
# Do not set NoNewPrivileges, or other options that imply it: PAM checks the password
# with the setgid unix_chkpwd helper, which cannot work without gaining privileges.

[Install]
WantedBy=multi-user.target
